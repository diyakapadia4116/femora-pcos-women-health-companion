# =========================================================
# Femora PCOS Companion - Backend environment variables
# (On Render: set these in Dashboard > Environment. Never commit a real .env)
# =========================================================

# Local dev: leave DATABASE_URL unset (or use SQLite)
# DATABASE_URL="sqlite:///./pcos_local.db"

# Supabase PostgreSQL - use the SESSION POOLER string (Supabase > Connect > Session pooler).
# Render's free tier has no IPv6, so the direct db.<ref>.supabase.co host will NOT connect.
# "postgresql://" / "postgres://" are auto-converted to the psycopg v3 driver.
# If your password has special characters (@ : / #) URL-encode them (e.g. @ -> %40).
DATABASE_URL="postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-YOUR_REGION.pooler.supabase.com:5432/postgres"

# JWT signing secret - set a long random string on Render
JWT_SECRET_KEY="change-me-to-a-long-random-string"

# Optional: restrict CORS (comma-separated). Leave unset to allow all origins.
# CORS_ORIGINS="https://femora-pcos-women-health-companion.vercel.app,http://localhost:5173"
