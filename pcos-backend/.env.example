# =========================================================
# PCOS & Women's Health Intelligence Platform - Environment Config
# =========================================================

# Database URL:
# 1. Default SQLite (local dev fallback):
# DATABASE_URL="sqlite:///./pcos_local.db"

# 2. Supabase PostgreSQL (Session Pooler — port 6543, IPv4-compatible):
# Format: postgresql://postgres:<password>@db.<project-ref>.supabase.co:6543/postgres
DATABASE_URL="postgresql://postgres:YOUR_SUPABASE_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:6543/postgres"

# JWT Secret Key for token signing:
JWT_SECRET_KEY="pcos_companion_super_secret_jwt_key_2024"
JWT_ALGORITHM="HS256"
JWT_EXPIRE_MINUTES="10080"
