# =========================================================
# PCOS & Women's Health Intelligence Platform - Environment Config
# =========================================================

# Database URL:
# 1. Default SQLite:
# DATABASE_URL="sqlite:///./pcos_companion.db"

# 2. PostgreSQL Configuration:
# Format: postgresql://<username>:<password>@<host>:<port>/<database_name>
DATABASE_URL="postgresql://postgres:your_postgres_password@localhost:5432/pcos_db"

# JWT Secret Key for token signing:
JWT_SECRET_KEY="pcos_companion_super_secret_jwt_key_2024"
JWT_ALGORITHM="HS256"
JWT_EXPIRE_MINUTES="10080"
